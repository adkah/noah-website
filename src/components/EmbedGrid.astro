---
interface Embed {
  src: string;
  title: string;
  allow?: string;
}

interface Props {
  embeds: Embed[];
}

const { embeds } = Astro.props;
---

<div class="embed-grid">
  {embeds.map(({ src, title, allow }) => (
    <div class="embed-frame">
      <iframe src={src} title={title} allow={allow} allowfullscreen loading="lazy"></iframe>
    </div>
  ))}
</div>

<style>
  .embed-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    width: 100%;
    max-width: 2000px;
  }

  .embed-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 768px) {
    .embed-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
