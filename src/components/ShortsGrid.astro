---
interface Short {
  src: string;
  title: string;
}

interface Props {
  shorts: Short[];
}

const { shorts } = Astro.props;
---

<div class="shorts-grid">
  {shorts.map(({ src, title }) => (
    <div class="short-frame">
      <iframe src={src} title={title} allowfullscreen loading="lazy"></iframe>
    </div>
  ))}
</div>

<style>
  .shorts-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    max-width: 2000px;
  }

  .short-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 9 / 16;
  }

  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 768px) {
    .shorts-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
