---
interface Props {
  margin?: string;
  maxWidth?: string;
}

const { margin = "12px auto 0", maxWidth = "1400px" } = Astro.props;
---

<p class="media-caption" style={`--caption-margin: ${margin}; --caption-max-width: ${maxWidth};`}>
  <slot />
</p>

<style>
  .media-caption {
    width: 100%;
    max-width: var(--caption-max-width);
    margin: var(--caption-margin);
    color: #888;
    font-size: 0.85rem;
    line-height: 1.4;
    text-align: left;
  }
</style>
